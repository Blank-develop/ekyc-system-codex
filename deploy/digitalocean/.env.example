# Copy this file to deploy/digitalocean/.env on the server.

# The single branded domain that serves the whole app (frontend + /api).
# Create a Route 53 (or any DNS) A record pointing this name to the server IP.
SITE_DOMAIN=ekyc.myawswebsite.site

# Same origin as SITE_DOMAIN. The frontend calls /api on the same host, so this
# just needs to allow the branded domain itself.
LALIGENCE_CORS_ORIGINS=https://ekyc.myawswebsite.site

# API authentication: comma-separated keys. When set, all /api endpoints require
# a matching X-API-Key header (for partner / server-to-server integrations).
# Leave unset for an open demo. Generate with: openssl rand -hex 24
# LALIGENCE_API_KEYS=replace-with-a-long-random-key,another-partner-key

# Per-user OAuth2 -> JWT auth (web console / operators). Set the secret to enable
# POST /api/auth/token and admin-by-JWT. Generate the secret with: openssl rand -hex 32
# Seed users with scripts/hash_password.py -> "username:pbkdf2_hash:role".
# LALIGENCE_JWT_SECRET=replace-with-a-long-random-secret
# LALIGENCE_JWT_EXPIRE_MINUTES=60
# LALIGENCE_AUTH_USERS=admin:pbkdf2_sha256$200000$...$...:admin

# Encryption at rest for biometric templates. When set, face templates are
# encrypted in the database. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LALIGENCE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Privacy: consent terms version recorded against each enrolled profile, and the
# data-retention window in days (>0 enables purge of idle profiles via the admin
# POST /api/profiles/purge-expired endpoint; 0 = retain indefinitely).
# LALIGENCE_CONSENT_VERSION=2026-06-v1
# LALIGENCE_PROFILE_RETENTION_DAYS=365

# PostgreSQL inside Docker Compose. Use a long random password.
POSTGRES_DB=laligence_ekyc
POSTGRES_USER=laligence
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend policy settings.
LALIGENCE_MAX_UPLOAD_SIZE_BYTES=8388608
LALIGENCE_MAX_REQUESTS_PER_MINUTE=240
LALIGENCE_ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp
LALIGENCE_MIN_FACE_MATCH_SCORE=0.68
LALIGENCE_MAX_PASSIVE_LIVENESS_RISK=0.34
LALIGENCE_MAX_DOCUMENT_FRAUD_RISK=0.42
LALIGENCE_FACE_LOGIN_MATCH_THRESHOLD=0.72
LALIGENCE_PAD_ENABLE_COMPANION_MODELS=false

# Copy this file to deploy/digitalocean/.env on the Droplet.

# Backend HTTPS domain. Create a DNS A record pointing this name to the Droplet IP.
API_DOMAIN=api.your-domain.com

# Vercel frontend URL. After Vercel creates the project, update this and redeploy/restart the API.
LALIGENCE_CORS_ORIGINS=https://your-vercel-project.vercel.app

# PostgreSQL inside Docker Compose. Use a long random password.
POSTGRES_DB=laligence_ekyc
POSTGRES_USER=laligence
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend policy settings.
LALIGENCE_MAX_UPLOAD_SIZE_BYTES=8388608
LALIGENCE_MAX_REQUESTS_PER_MINUTE=240
LALIGENCE_ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp
LALIGENCE_MIN_FACE_MATCH_SCORE=0.68
LALIGENCE_MAX_PASSIVE_LIVENESS_RISK=0.34
LALIGENCE_MAX_DOCUMENT_FRAUD_RISK=0.42
LALIGENCE_FACE_LOGIN_MATCH_THRESHOLD=0.72
LALIGENCE_PAD_ENABLE_COMPANION_MODELS=false

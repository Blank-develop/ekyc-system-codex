# One branded domain serves the whole app:
#   /api/*  -> FastAPI backend (api:8000)
#   /*      -> built Vite frontend (static SPA, baked into the web image at /srv)
# Caddy obtains and renews HTTPS certificates automatically (Let's Encrypt).
{$SITE_DOMAIN} {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy api:8000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer-when-downgrade"
  }
}

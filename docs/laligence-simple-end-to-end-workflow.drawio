        </mxCell>
        <mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b42318;endArrow=block;endFill=1;fontColor=#b42318;fontStyle=1;" edge="1" parent="1" source="docPass" target="docRetry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#13795b;endArrow=block;endFill=1;fontColor=#13795b;fontStyle=1;" edge="1" parent="1" source="docPass" target="activeLive">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#18336f;endArrow=block;endFill=1;" edge="1" parent="1" source="activeLive" target="gesture">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#18336f;endArrow=block;endFill=1;" edge="1" parent="1" source="gesture" target="selfie">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#18336f;endArrow=block;endFill=1;" edge="1" parent="1" source="selfie" target="bioPass">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b42318;endArrow=block;endFill=1;fontColor=#b42318;fontStyle=1;" edge="1" parent="1" source="bioPass" target="reject">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#13795b;endArrow=block;endFill=1;fontColor=#13795b;fontStyle=1;" edge="1" parent="1" source="bioPass" target="approve">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#13795b;endArrow=block;endFill=1;" edge="1" parent="1" source="approve" target="profileStore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#18336f;endArrow=block;endFill=1;" edge="1" parent="1" source="returnUser" target="faceLogin">
          <mxGeometry relative="1" as="geometry"/>
